<header class="position-sticky top-0 bg-neutral-0-transparent-50">
  <nav class="py-3">
    <div class="container d-flex justify-content-between">
      <!-- logo、搜尋欄位 -->
      <div class="d-flex align-items-center gap-4 py-6">
        <a href="#">
          <img
            src="../assets/images/index/LOGO.png"
            alt="品牌標誌"
            title="品牌標誌"
          />
        </a>
        <div class="input-group flex-nowrap mw-1 min-w-1">
          <span
            class="input-group-text py-8 ps-9 pe-7 border-end-0 bg-neutral-0"
            id="addon-wrapping"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M19.6 21L13.3 14.7C12.8 15.1 12.225 15.4167 11.575 15.65C10.925 15.8833 10.2333 16 9.5 16C7.68333 16 6.14583 15.3708 4.8875 14.1125C3.62917 12.8542 3 11.3167 3 9.5C3 7.68333 3.62917 6.14583 4.8875 4.8875C6.14583 3.62917 7.68333 3 9.5 3C11.3167 3 12.8542 3.62917 14.1125 4.8875C15.3708 6.14583 16 7.68333 16 9.5C16 10.2333 15.8833 10.925 15.65 11.575C15.4167 12.225 15.1 12.8 14.7 13.3L21 19.6L19.6 21ZM9.5 14C10.75 14 11.8125 13.5625 12.6875 12.6875C13.5625 11.8125 14 10.75 14 9.5C14 8.25 13.5625 7.1875 12.6875 6.3125C11.8125 5.4375 10.75 5 9.5 5C8.25 5 7.1875 5.4375 6.3125 6.3125C5.4375 7.1875 5 8.25 5 9.5C5 10.75 5.4375 11.8125 6.3125 12.6875C7.1875 13.5625 8.25 14 9.5 14Z"
                fill="#909090"
              />
            </svg>
          </span>
          <input
            type="text"
            class="form-control py-8 pe-9 ps-0 text-neutral-100 fw-normal border-start-0"
            placeholder="搜尋景點、地點或城市"
            aria-label="Username"
            aria-describedby="addon-wrapping"
          />
        </div>
      </div>
      <!-- 購物車、登入註冊 -->
      <div class="d-flex align-items-center gap-10">
        <a href="#" class="py-2 px-9">
          <img
            src="../assets/images/icons/ic_Cart.svg"
            alt="購物車"
            title="購物車"
          />
        </a>
        <button type="button" class="btn btn-primary-custom btn-lg">
          登入 / 註冊
        </button>
      </div>
    </div>
  </nav>
</header>
